# Nothing here is required to run the app: demo mode works with no key.
#
# Visitors add their own Anthropic key in the UI. It is sent per request in the
# x-anthropic-key header and is never stored or logged by the server.
#
# The two variables below are for LOCAL development and fixture recording only.
# Never set ALLOW_SERVER_KEY on a public deployment: it would let any visitor
# spend this key's credits.
ANTHROPIC_API_KEY=
ALLOW_SERVER_KEY=
